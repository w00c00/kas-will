pragma silverscript ^0.1.0;

contract InheritanceVault(pubkey owner, pubkey[] inheritors, int[] sharesBps, int inactivityPeriod) {
    int constant MAX_INHERITORS = 5;
    int constant SHARE_SCALE = 10000;
    int constant MAX_MINER_FEE = 10000000;

    function requireSingleCovenantInput() {
        require(tx.inputs.length == 1);
        require(this.activeInputIndex == 0);
        byte[32] covId = OpInputCovenantId(this.activeInputIndex);
        require(OpCovInputCount(covId) == 1);
    }

    function requireFee(int minerFee) {
        require(minerFee >= 0);
        require(minerFee <= MAX_MINER_FEE);
        require(tx.inputs[this.activeInputIndex].value > minerFee);
    }

    entrypoint function checkIn(sig ownerSignature, int minerFee) {
        require(checkSig(ownerSignature, owner));
        requireFee(minerFee);
        requireSingleCovenantInput();
        require(tx.outputs.length == 1);
        require(OpAuthOutputCount(this.activeInputIndex) == 1);
        int continuation = OpAuthOutputIdx(this.activeInputIndex, 0);
        require(continuation == 0);
        require(tx.outputs[continuation].scriptPubKey == tx.inputs[this.activeInputIndex].scriptPubKey);
        require(tx.outputs[continuation].value == tx.inputs[this.activeInputIndex].value - minerFee);
    }

    entrypoint function recover(sig ownerSignature, int minerFee) {
        require(checkSig(ownerSignature, owner));
        requireFee(minerFee);
        requireSingleCovenantInput();
        require(tx.outputs.length == 1);
        require(OpAuthOutputCount(this.activeInputIndex) == 0);
        byte[34] ownerScript = new ScriptPubKeyP2PK(owner);
        require(tx.outputs[0].scriptPubKey == byte[](ownerScript));
        require(tx.outputs[0].value == tx.inputs[this.activeInputIndex].value - minerFee);
    }

    entrypoint function inherit(int minerFee) {
        require(this.age >= inactivityPeriod);
        requireFee(minerFee);
        requireSingleCovenantInput();
        require(inheritors.length >= 2);
        require(inheritors.length <= MAX_INHERITORS);
        require(sharesBps.length == inheritors.length);
        require(tx.outputs.length == inheritors.length);
        require(OpAuthOutputCount(this.activeInputIndex) == 0);

        int distributable = tx.inputs[this.activeInputIndex].value - minerFee;
        int base = distributable / SHARE_SCALE;
        int remainder = distributable % SHARE_SCALE;
        int paid = 0;
        int shareTotal = 0;

        for(i, 0, inheritors.length, MAX_INHERITORS) {
            int share = sharesBps[i];
            require(share > 0);
            shareTotal = shareTotal + share;
            int amount = base * share + (remainder * share) / SHARE_SCALE;
            if (i == inheritors.length - 1) {
                amount = distributable - paid;
            }
            require(amount > 0);
            byte[34] inheritorScript = new ScriptPubKeyP2PK(inheritors[i]);
            require(tx.outputs[i].scriptPubKey == byte[](inheritorScript));
            require(tx.outputs[i].value == amount);
            paid = paid + amount;
        }

        require(shareTotal == SHARE_SCALE);
        require(paid == distributable);
    }
}
