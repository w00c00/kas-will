pragma silverscript ^0.1.0;

contract KCC721V2Ticket(
    byte[] nftTemplatePrefix,
    byte[] nftTemplateSuffix,
    byte[32] nftTemplateHash,
    byte[32] initialCollectionId,
    int initialMintIndex,
    int initialMaxSupply,
    byte[32] initialMetadataDigest,
    byte[32] initialShuffleRoot,
    pubkey initialRecipient
) {
    byte[32] collectionId = initialCollectionId;
    int mintIndex = initialMintIndex;
    int maxSupply = initialMaxSupply;
    byte[32] metadataDigest = initialMetadataDigest;
    byte[32] shuffleRoot = initialShuffleRoot;
    pubkey recipient = initialRecipient;

    struct NFTState {
        byte[32] collectionId;
        int tokenId;
        byte[32] metadataDigest;
        pubkey owner;
    }

    #[covenant.singleton(termination = allowed)]
    function reveal(State prevState, State[] newStates, int tokenId, byte[32] salt, byte[32][] siblings, byte[] directions, int nftOutputIndex) {
        require(newStates.length == 0);
        require(prevState.collectionId == collectionId);
        require(mintIndex >= 1);
        require(mintIndex <= maxSupply);
        require(tokenId >= 1);
        require(tokenId <= maxSupply);
        require(siblings.length == directions.length);
        require(siblings.length <= 32);
        byte[] leafData = byte[](mintIndex as byte[8]) + byte[](tokenId as byte[8]) + byte[](salt);
        byte[32] node = sha256(leafData);
        for (i, 0, siblings.length, 32) {
            int direction = OpBin2Num(byte[](directions[i]));
            require(direction == 0 || direction == 1);
            if (direction == 0) {
                byte[] rightData = byte[](node) + byte[](siblings[i]);
                node = sha256(rightData);
            } else {
                byte[] leftData = byte[](siblings[i]) + byte[](node);
                node = sha256(leftData);
            }
        }
        require(node == shuffleRoot);
        NFTState nftState = NFTState {
            collectionId: collectionId,
            tokenId: tokenId,
            metadataDigest: metadataDigest,
            owner: recipient
        };
        validateOutputStateWithTemplate(nftOutputIndex, nftState, nftTemplatePrefix, nftTemplateSuffix, nftTemplateHash);
        require(tx.outputs[nftOutputIndex].value >= 50000000);
    }
}
