pragma silverscript ^0.1.0;

contract HashlockRefund(pubkey sender, pubkey recipient, byte[32] secretHash, int timeout) {
    entry claim(byte[] secret, sig recipientSignature) {
        require(sha256(secret) == secretHash);
        require(checkSig(recipientSignature, recipient));
    }

    entry refund(sig senderSignature) {
        require(checkSig(senderSignature, sender));
        require(tx.time >= timeout);
    }
}
