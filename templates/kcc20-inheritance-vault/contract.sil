pragma silverscript ^0.1.0;

contract KCC20InheritanceVault(
    pubkey owner,
    pubkey[] inheritors,
    int[] sharesBps,
    int inactivityPeriod,
    byte[32] kcc20Covid,
    int tokenTemplatePrefixLen,
    int tokenTemplateSuffixLen,
    byte[32] expectedTokenTemplateHash
) {
    int constant MAX_INHERITORS = 5;
    int constant SHARE_SCALE = 10000;
    int constant MAX_MINER_FEE = 100000000;
    byte constant IDENTIFIER_PUBKEY = 0x00;
    byte constant IDENTIFIER_COVENANT_ID = 0x02;

    struct KCC20State {
        byte[32] ownerIdentifier;
        byte identifierType;
        int amount;
        bool isMinter;
    }

    function requireFee(int minerFee) {
        require(minerFee >= 0);
        require(minerFee <= MAX_MINER_FEE);
    }

    function requireControllerInput() {
        require(this.activeInputIndex == 0);
        byte[32] controllerId = OpInputCovenantId(this.activeInputIndex);
        require(OpCovInputCount(controllerId) == 1);
    }

    function requireTokenInput(int tokenInputIndex, KCC20State previousTokenState) {
        require(tokenInputIndex == 1);
        require(previousTokenState.ownerIdentifier == OpInputCovenantId(this.activeInputIndex));
        require(previousTokenState.identifierType == IDENTIFIER_COVENANT_ID);
        require(!previousTokenState.isMinter);
    }

    entry checkIn(sig ownerSignature, int minerFee) {
        require(checkSig(ownerSignature, owner));
        requireFee(minerFee);
        requireControllerInput();
        require(tx.inputs.length == 1);
        require(tx.outputs.length == 1);
        require(tx.inputs[0].value > minerFee);
        require(OpAuthOutputCount(this.activeInputIndex) == 1);
        int continuation = OpAuthOutputIdx(this.activeInputIndex, 0);
        require(continuation == 0);
        require(tx.outputs[0].scriptPubKey == tx.inputs[0].scriptPubKey);
        require(tx.outputs[0].value == tx.inputs[0].value - minerFee);
    }

    entry recover(sig ownerSignature, int minerFee) {
        require(checkSig(ownerSignature, owner));
        requireFee(minerFee);
        requireControllerInput();
        require(tx.inputs.length == 2);
        require(tx.outputs.length == 1);
        require(OpCovInputCount(kcc20Covid) == 1);
        require(OpCovOutputCount(kcc20Covid) == 1);
        int tokenInputIndex = OpCovInputIdx(kcc20Covid, 0);
        KCC20State previousTokenState = readInputStateWithTemplate(
            tokenInputIndex,
            tokenTemplatePrefixLen,
            tokenTemplateSuffixLen,
            expectedTokenTemplateHash
        );
        requireTokenInput(tokenInputIndex, previousTokenState);
        KCC20State ownerTokenState = KCC20State {
            ownerIdentifier: byte[32](owner),
            identifierType: IDENTIFIER_PUBKEY,
            amount: previousTokenState.amount,
            isMinter: false
        };
        validateOutputStateWithInputTemplate(
            OpCovOutputIdx(kcc20Covid, 0),
            ownerTokenState,
            tokenInputIndex,
            tokenTemplatePrefixLen,
            tokenTemplateSuffixLen,
            expectedTokenTemplateHash
        );
        int available = tx.inputs[0].value + tx.inputs[1].value - minerFee;
        require(available > 0);
        require(tx.outputs[0].value == available);
        require(OpAuthOutputCount(this.activeInputIndex) == 0);
    }

    entry inherit(int minerFee) {
        require(this.age >= inactivityPeriod);
        requireFee(minerFee);
        requireControllerInput();
        require(tx.inputs.length == 2);
        require(inheritors.length >= 2);
        require(inheritors.length <= MAX_INHERITORS);
        require(sharesBps.length == inheritors.length);
        require(tx.outputs.length == inheritors.length);
        require(OpCovInputCount(kcc20Covid) == 1);
        require(OpCovOutputCount(kcc20Covid) == inheritors.length);
        int tokenInputIndex = OpCovInputIdx(kcc20Covid, 0);
        KCC20State previousTokenState = readInputStateWithTemplate(
            tokenInputIndex,
            tokenTemplatePrefixLen,
            tokenTemplateSuffixLen,
            expectedTokenTemplateHash
        );
        requireTokenInput(tokenInputIndex, previousTokenState);

        int tokenBase = previousTokenState.amount / SHARE_SCALE;
        int tokenRemainder = previousTokenState.amount % SHARE_SCALE;
        int valueAvailable = tx.inputs[0].value + tx.inputs[1].value - minerFee;
        require(valueAvailable > 0);
        int valueBase = valueAvailable / SHARE_SCALE;
        int valueRemainder = valueAvailable % SHARE_SCALE;
        int tokenPaid = 0;
        int valuePaid = 0;
        int shareTotal = 0;

        for(i, 0, inheritors.length, MAX_INHERITORS) {
            int share = sharesBps[i];
            require(share > 0);
            shareTotal = shareTotal + share;
            int tokenAmount = tokenBase * share + (tokenRemainder * share) / SHARE_SCALE;
            int outputValue = valueBase * share + (valueRemainder * share) / SHARE_SCALE;
            if (i == inheritors.length - 1) {
                tokenAmount = previousTokenState.amount - tokenPaid;
                outputValue = valueAvailable - valuePaid;
            }
            require(tokenAmount > 0);
            require(outputValue > 0);
            KCC20State newTokenState = KCC20State {
                ownerIdentifier: byte[32](inheritors[i]),
                identifierType: IDENTIFIER_PUBKEY,
                amount: tokenAmount,
                isMinter: false
            };
            int outputIndex = OpCovOutputIdx(kcc20Covid, i);
            validateOutputStateWithInputTemplate(
                outputIndex,
                newTokenState,
                tokenInputIndex,
                tokenTemplatePrefixLen,
                tokenTemplateSuffixLen,
                expectedTokenTemplateHash
            );
            require(tx.outputs[outputIndex].value == outputValue);
            tokenPaid = tokenPaid + tokenAmount;
            valuePaid = valuePaid + outputValue;
        }

        require(shareTotal == SHARE_SCALE);
        require(tokenPaid == previousTokenState.amount);
        require(valuePaid == valueAvailable);
        require(OpAuthOutputCount(this.activeInputIndex) == 0);
    }
}
