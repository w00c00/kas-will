# The server binds to loopback by default. Do not expose it publicly.
HOST=127.0.0.1
PORT=4310

# Optional AI-provider fallback for automation. Desktop users can configure the encrypted vault in the UI.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-sol
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
OPENROUTER_API_KEY=
OPENROUTER_MODEL=~openai/gpt-latest
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3-coder
COMPATIBLE_BASE_URL=
COMPATIBLE_API_KEY=
COMPATIBLE_MODEL=

# Optional overrides. setup:silverc writes config/compiler.json instead.
SILVERC_BIN=
SILVERC_SHA256=

# Mainnet stays disabled unless every guard below is set deliberately.
ALLOW_MAINNET=false
MAINNET_MAX_DEPLOY_KAS=1
KASCOV_BASE_URL=https://kascov.io
KASCOV_PREFLIGHT_BIN=./bin/kascov-preflight
KASCOV_PREFLIGHT_SHA256=
# Optional direct Kaspa wRPC endpoints. When empty, public-node discovery is used.
KASPA_TN10_RPC_URL=
KASPA_MAINNET_RPC_URL=
