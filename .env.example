# The server binds to loopback by default. Do not expose it publicly.
HOST=127.0.0.1
PORT=4320

# Optional overrides. setup:silverc writes config/compiler.json instead.
SILVERC_BIN=
SILVERC_SHA256=

# Mainnet stays disabled unless every guard below is set deliberately.
ALLOW_MAINNET=false
MAINNET_MAX_DEPLOY_KAS=1
KASCOV_BASE_URL=https://kascov.io
KASCOV_PREFLIGHT_BIN=./bin/kascov-preflight
KASCOV_PREFLIGHT_SHA256=
# Optional secondary web verification. Local preflight remains authoritative.
ENABLE_KASCOV_VERIFY=false
# Optional direct Kaspa wRPC endpoints. When empty, public-node discovery is used.
KASPA_TN10_RPC_URL=
KASPA_MAINNET_RPC_URL=
